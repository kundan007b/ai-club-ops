{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ProjectProposalMetadata",
  "description": "Validation schema for AI Club Nalanda University project incubation proposals",
  "type": "object",
  "required": [
    "title",
    "authors",
    "target_stage",
    "primary_discipline",
    "requested_tier",
    "estimated_duration_weeks"
  ],
  "properties": {
    "title": {
      "type": "string",
      "minLength": 3,
      "maxLength": 100
    },
    "authors": {
      "type": "array",
      "minItems": 2,
      "description": "Must have at least 2 authors enforcing the 2-in-a-Pod rule",
      "items": {
        "type": "object",
        "required": ["name", "email", "role", "background"],
        "properties": {
          "name": { "type": "string", "minLength": 2 },
          "email": { "type": "string", "format": "email" },
          "role": {
            "type": "string",
            "enum": ["technical_lead", "domain_lead", "contributor"]
          },
          "background": { "type": "string", "minLength": 2 }
        }
      }
    },
    "target_stage": {
      "type": "string",
      "enum": ["SPARK", "SPRINT", "FLAGSHIP", "LAUNCH"]
    },
    "primary_discipline": {
      "type": "string",
      "minLength": 2
    },
    "tags": {
      "type": "array",
      "items": { "type": "string" }
    },
    "requested_tier": {
      "type": "string",
      "enum": ["Tier-1", "Tier-2", "Tier-3"]
    },
    "estimated_duration_weeks": {
      "type": "integer",
      "minimum": 1,
      "maximum": 52
    }
  }
}
