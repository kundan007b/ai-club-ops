{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ComputeAllocationRequest",
  "description": "Validation schema for AI Club Nalanda University compute allocation requests",
  "type": "object",
  "required": [
    "version",
    "project",
    "allocation_details",
    "workload_specification",
    "safety_and_hygiene"
  ],
  "properties": {
    "version": { "type": "string" },
    "project": {
      "type": "object",
      "required": ["codename", "github_repo", "lead_name", "lead_email", "pod_members"],
      "properties": {
        "codename": { "type": "string", "minLength": 3 },
        "github_repo": { "type": "string", "format": "uri" },
        "lead_name": { "type": "string", "minLength": 2 },
        "lead_email": { "type": "string", "format": "email" },
        "pod_members": {
          "type": "array",
          "minItems": 2,
          "items": { "type": "string" }
        }
      }
    },
    "allocation_details": {
      "type": "object",
      "required": [
        "tier",
        "provider",
        "hardware_type",
        "estimated_gpu_hours",
        "estimated_cost_inr",
        "start_date",
        "end_date"
      ],
      "properties": {
        "tier": {
          "type": "string",
          "enum": ["Tier-1", "Tier-2", "Tier-3"]
        },
        "provider": {
          "type": "string",
          "enum": ["RunPod", "GCP", "AWS", "OpenAI_API", "Anthropic_API", "Gemini_API", "HuggingFace", "LocalCluster"]
        },
        "hardware_type": { "type": "string" },
        "estimated_gpu_hours": { "type": "number", "minimum": 0 },
        "estimated_cost_inr": { "type": "number", "minimum": 0, "maximum": 50000 },
        "start_date": { "type": "string" },
        "end_date": { "type": "string" }
      }
    },
    "workload_specification": {
      "type": "object",
      "required": [
        "framework",
        "dataset_size_gb",
        "batch_size",
        "max_runtime_per_job_hours",
        "idle_auto_shutdown_minutes"
      ],
      "properties": {
        "framework": { "type": "string" },
        "dataset_size_gb": { "type": "number", "minimum": 0 },
        "batch_size": { "type": "integer", "minimum": 1 },
        "max_runtime_per_job_hours": { "type": "number", "minimum": 0.1, "maximum": 48 },
        "idle_auto_shutdown_minutes": { "type": "integer", "minimum": 5, "maximum": 60 }
      }
    },
    "safety_and_hygiene": {
      "type": "object",
      "required": [
        "keys_vault_confirmed",
        "public_loss_curves_agreement",
        "open_source_commitment"
      ],
      "properties": {
        "keys_vault_confirmed": { "type": "boolean", "const": true },
        "public_loss_curves_agreement": { "type": "boolean", "const": true },
        "open_source_commitment": { "type": "boolean", "const": true }
      }
    }
  }
}
